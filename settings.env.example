# ==============================================================================
# CONFIGURATION TEMPLATE (settings.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. DO NOT edit this file directly.
# 2. Copy this file to a new file named 'settings.env' in this same directory.
# 3. Uncomment and update values as needed.
#
# NOTE: The master script will use this file for testing if 'settings.env'
# is missing, but 'settings.env' will always take priority.
# ==============================================================================


# --- ENVIRONMENT IDENTITY ---
# A human identifier for this specific environment (e.g., dev, test, production).
# This will be used in logs and metadata.
ENV_NAME="testing-$(date +'%y%m%d-%H%M')"


# --- PLATFORM PATH SETTINGS ---
# The absolute path where the lab platform will be created.
# If left blank, defaults to a sibling directory of this bootstrap folder.
# Example: LAB_HOME=/home/ubuntu/my_data_labs
LAB_HOME=


# ==============================================================================
# POSTGRESQL CONFIGURATION
# ==============================================================================

# --- POSTGRESQL VERSION ---
# Major version of PostgreSQL to install.
# Supported: 15, 16, 17, 18
# Default: 18
# PG_VERSION="18"


# --- POSTGRESQL DATA DIRECTORY ---
# Absolute path for PostgreSQL data files.
# Default: ${LAB_HOME}/data/postgres
# PGDATA=


# --- POSTGRESQL USER PREFIX ---
# Prefix for the auto-generated database admin user.
# A unique suffix is appended automatically.
# Default: lab_admin
# PG_LAB_USER_PREFIX="lab_admin"


# --- POSTGRESQL DATABASE NAME ---
# Name of the default database created in the lab.
# Default: dev_lab
# PG_LAB_DB="dev_lab"


# --- POSTGRESQL PERFORMANCE TUNING ---
# Shared buffers: memory allocated for caching.
# Default: 128MB
# PG_SHARED_BUFFERS="128MB"

# Maximum concurrent database connections.
# Default: 100
# PG_MAX_CONNECTIONS="100"

# --- POSTGRESQL NETWORK CONFIGURATION ---
# The network interface PostgreSQL listens on.
# 'localhost' — local access only (default, most secure)
# '*' — all interfaces (required for remote access)
# Default: localhost
# PG_LISTEN_ADDRESSES="localhost"


# ==============================================================================
# AIRFLOW CONFIGURATION
# ==============================================================================

# --- AIRFLOW VERSION ---
# Version of Apache Airflow to install.
# Supported: 3.x
# Default: 3.2.0
# AIRFLOW_VERSION="3.2.0"


# --- AIRFLOW EXECUTOR ---
# Options: LocalExecutor (default), SequentialExecutor, CeleryExecutor, KubernetesExecutor
# Default: LocalExecutor
# AIRFLOW_EXECUTOR="LocalExecutor"


# --- AIRFLOW METADATA DATABASE ---
# Database name in PostgreSQL for Airflow's internal state.
# Default: airflow_db
# AIRFLOW_DB_NAME="airflow_db"


# --- AIRFLOW DATABASE USER PREFIX ---
# Prefix for the auto-generated Airflow database user.
# Default: airflow_admin
# AIRFLOW_DB_USER_PREFIX="airflow_admin"


# --- AIRFLOW DAGS FOLDER ---
# Absolute path where DAG files are stored.
# Default: ${LAB_HOME}/data/airflow/dags
# AIRFLOW_DAGS_FOLDER=


# --- AIRFLOW EXAMPLES ---
# Whether to load example DAGs included with Airflow.
# Default: false
# AIRFLOW_LOAD_EXAMPLES="false"


# --- AIRFLOW API SERVER CONFIG ---
# Whether to expose Airflow configuration in the web UI.
# Default: false (security best practice)
# AIRFLOW__API__EXPOSE_CONFIG="false"


# --- AIRFLOW POSTGRES CONNECTION ID ---
# The Airflow connection name for the lab's PostgreSQL database.
# Default: lab_postgres
# AIRFLOW_POSTGRES_CONN_ID="lab_postgres"


# ==============================================================================
# JAVA CONFIGURATION
# ==============================================================================

# --- JAVA MAJOR VERSION ---
# Major version of Eclipse Temurin JDK to install per lab via Adoptium API.
# The latest GA release for this major version is fetched automatically.
# Minimum: 17 (required by Kafka 4.x). Later versions are backward-compatible.
# Default: 17
# JAVA_MAJOR="17"


# ==============================================================================
# KAFKA CONFIGURATION
# ==============================================================================

# --- KAFKA VERSION ---
# Version of Apache Kafka to install (KRaft only, ZooKeeper removed in 4.x).
# Default: 4.0.2
# KAFKA_VERSION="4.0.2"

# --- KAFKA HEAP MEMORY ---
# JVM heap settings for the Kafka broker.
# Default: -Xmx512M -Xms256M
# KAFKA_HEAP_OPTS="-Xmx512M -Xms256M"

# --- KAFKA LOG RETENTION ---
# How long Kafka retains topic data before deletion (in hours).
# Default: 72 (3 days)
# KAFKA_LOG_RETENTION_HOURS="72"

# --- KAFKA DATA DIRECTORY ---
# Absolute path for Kafka topic data and KRaft metadata.
# Separated from engine binaries to preserve data across version upgrades.
# Default: ${LAB_HOME}/data/kafka
# KAFKA_DATA_DIR=

# --- KAFKA SASL AUTHENTICATION ---
# Enable SASL/PLAIN authentication for Kafka.
# When enabled, a kafka_admin user is created with generated password.
# Default: true
# KAFKA_ENABLE_SASL="true"


# ==============================================================================
# SCHEMA REGISTRY CONFIGURATION (Apicurio)
# ==============================================================================

# --- SCHEMA REGISTRY VERSION ---
# Version of Apicurio Registry to install.
# Default: 3.2.4
# SCHEMA_REGISTRY_VERSION="3.2.4"

# --- SCHEMA REGISTRY HEAP MEMORY ---
# JVM heap settings for Schema Registry.
# Default: -Xmx256M -Xms128M
# SCHEMA_REGISTRY_HEAP_OPTS="-Xmx256M -Xms128M"


# ==============================================================================
# KAFKA CONNECT CONFIGURATION
# ==============================================================================

# --- KAFKA CONNECT HEAP MEMORY ---
# JVM heap settings for Kafka Connect worker.
# Default: -Xmx512M -Xms256M
# CONNECT_HEAP_OPTS="-Xmx512M -Xms256M"


# ==============================================================================
# DEBEZIUM CDC CONFIGURATION
# ==============================================================================

# --- DEBEZIUM VERSION ---
# Version of Debezium PostgreSQL connector to install.
# Must be compatible with the Kafka and PostgreSQL versions.
# Default: 3.4.3.Final
# DEBEZIUM_VERSION="3.4.3.Final"

# --- DEBEZIUM TABLE INCLUDE LIST ---
# Comma-separated list of schemas and tables for CDC capture.
# Default: raw.*,staging.*,analytics.*
# DEBEZIUM_TABLE_INCLUDE_LIST="raw.*,staging.*,analytics.*"


# ==============================================================================
# STREAMING SERVICES CONTROL
# ==============================================================================

# --- START STREAMING SERVICES ---
# Whether to start Kafka, Schema Registry, and Connect when lab_entry.sh runs.
# Set to "true" to auto-start streaming services on lab entry.
# Set to "false" to run only PostgreSQL + Airflow (light mode).
# Default: true
# START_STREAMING_SERVICES="true"