# ==============================================================================
# CONFIGURATION TEMPLATE (settings.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. DO NOT edit this file directly.
# 2. Copy this file to a new file named 'settings.env' in this same directory.
# 3. Uncomment and update values as needed.
#
# NOTE: The master script will use this file for testing if 'settings.env'
# is missing, but 'settings.env' will always take priority.
# ==============================================================================


# --- ENVIRONMENT IDENTITY ---
# A human identifier for this specific environment (e.g., dev, test, production).
# This will be used in logs and metadata.
ENV_NAME="testing-$(date +'%y%m%d-%H%M')"


# --- PLATFORM PATH SETTINGS ---
# The absolute path where the lab platform will be created.
# If left blank, defaults to a sibling directory of this bootstrap folder.
# Example: LAB_HOME=/home/ubuntu/my_data_labs
LAB_HOME=


# ==============================================================================
# POSTGRESQL CONFIGURATION
# ==============================================================================

# --- POSTGRESQL VERSION ---
# Major version of PostgreSQL to install.
# Supported: 15, 16, 17, 18
# Default: 18
# PG_VERSION="18"


# --- POSTGRESQL DATA DIRECTORY ---
# Absolute path for PostgreSQL data files.
# Useful if you want data on a separate disk or partition.
# Default: ${LAB_HOME}/data/postgres
# PGDATA=


# --- POSTGRESQL USER PREFIX ---
# Prefix for the auto-generated database admin user.
# A unique suffix is appended automatically to prevent conflicts across labs.
# Default: lab_admin
# Example result: lab_admin_a3f2b1c0
# PG_LAB_USER_PREFIX="lab_admin"


# --- POSTGRESQL DATABASE NAME ---
# Name of the default database created in the lab.
# Default: dev_lab
# PG_LAB_DB="dev_lab"


# --- POSTGRESQL PERFORMANCE TUNING ---
# Shared buffers: memory allocated for caching.
# Increase for larger datasets. Default: 128MB
# PG_SHARED_BUFFERS="128MB"

# Maximum concurrent database connections.
# Increase for high-concurrency workloads. Default: 100
# PG_MAX_CONNECTIONS="100"

# --- POSTGRESQL NETWORK CONFIGURATION ---
# The network interface PostgreSQL listens on.
# 'localhost' — local access only (default, most secure)
# '*' — all interfaces (required for remote access)
# Default: localhost
# PG_LISTEN_ADDRESSES="localhost"


# ==============================================================================
# AIRFLOW CONFIGURATION
# ==============================================================================

# --- AIRFLOW VERSION ---
# Version of Apache Airflow to install.
# Uses the official constraints file for reproducible installations.
# Supported: 3.x (Airflow 2.x reaches EOL April 2026)
# Default: 3.2.0
# AIRFLOW_VERSION="3.2.0"


# --- AIRFLOW EXECUTOR ---
# The executor determines how and where tasks are executed.
# Options: LocalExecutor (default), SequentialExecutor (testing only),
#          CeleryExecutor, KubernetesExecutor
# Note: CeleryExecutor and KubernetesExecutor require additional infrastructure.
# Default: LocalExecutor
# AIRFLOW_EXECUTOR="LocalExecutor"


# --- AIRFLOW METADATA DATABASE ---
# Database name in PostgreSQL for Airflow's internal state.
# Default: airflow_db
# AIRFLOW_DB_NAME="airflow_db"


# --- AIRFLOW DATABASE USER PREFIX ---
# Prefix for the auto-generated Airflow database user.
# A unique suffix is appended automatically.
# Default: airflow_admin
# Example result: airflow_admin_a3f2b1c0
# AIRFLOW_DB_USER_PREFIX="airflow_admin"


# --- AIRFLOW DAGS FOLDER ---
# Absolute path where DAG files are stored.
# Default: ${LAB_HOME}/data/airflow/dags
# AIRFLOW_DAGS_FOLDER=


# --- AIRFLOW EXAMPLES ---
# Whether to load example DAGs included with Airflow.
# Default: false (set to "true" only for learning purposes)
# AIRFLOW_LOAD_EXAMPLES="false"


# --- AIRFLOW API SERVER CONFIG ---
# Whether to expose Airflow configuration in the web UI.
# Default: false (security best practice)
# AIRFLOW__API__EXPOSE_CONFIG="false"


# --- AIRFLOW POSTGRES CONNECTION ID ---
# The Airflow connection name for accessing the lab's PostgreSQL database.
# This is the value you use in DAGs: PostgresOperator(postgres_conn_id="...")
# Default: lab_postgres
# AIRFLOW_POSTGRES_CONN_ID="lab_postgres"
