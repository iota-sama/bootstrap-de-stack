# ==============================================================================
# CONFIGURATION TEMPLATE (settings.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. DO NOT edit this file directly. 
# 2. Copy this file to a new file named 'settings.env' in this same directory.
# 3. Update the values in 'settings.env' with your own configuration/passwords.
#
# NOTE: The master script will use this file for testing if 'settings.env' 
# is missing, but 'settings.env' will always take priority.
# ==============================================================================

# --- ENVIRONMENT IDENTITY ---
# A human identifier for this specific environment (e.g., dev, test, production).
# This will be used in logs and metadata.
ENV_NAME="testing-$(date +'%y%m%d-%H%M')"

# --- PLATFORM PATH SETTINGS ---
# The absolute path where the 'de_stack_vm' platform will be created.
# If left blank, it defaults to the directory sibling to this bootstrap folder.
# Example: STACK_HOME=/home/ubuntu/my_custom_stack
STACK_HOME=
